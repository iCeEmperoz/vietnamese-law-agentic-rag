# Environment settings for Vietnamese Law Agentic RAG system

# LLM Provider Configuration: 'gemini' or 'groq'
LLM_PROVIDER=gemini

# Google Gemini API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Keys (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Storage Paths
CHROMA_PERSIST_DIR=data/chroma
BM25_INDEX_PATH=data/bm25/bm25_index.pkl
GRAPH_INDEX_PATH=data/graph/graph_index.json
